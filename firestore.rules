rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check from users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'super_admin'
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    function isNotBanned() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'banned'
      );
    }

    function areFriends(uid1, uid2) {
      return exists(/databases/$(database)/documents/friendships/$('friendship_' + uid1 + '_' + uid2)) ||
             exists(/databases/$(database)/documents/friendships/$('friendship_' + uid2 + '_' + uid1));
    }

    function areNotBlocked(uid1, uid2) {
      return !exists(/databases/$(database)/documents/blocks/$('block_' + uid1 + '_' + uid2)) &&
             !exists(/databases/$(database)/documents/blocks/$('block_' + uid2 + '_' + uid1));
    }

    // 1. Users Collection
    match /users/{userId} {
      // Anyone can read basic user profile directory/count, or self
      allow read: if true;
      // Only self can create their account upon initial signup
      allow create: if isOwner(userId);
      // Users can update their own profile; only admins can change roles, accountStatus, or ban
      allow update: if isAuthenticated() && (
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus']))) ||
        isAdmin()
      );
      // Only Super Admin or the user themselves can delete their account
      allow delete: if isOwner(userId) || isSuperAdmin();

      // User Contacts Subcollection
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 3. Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // 4. Friendships
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
    }

    // 5. Blocks
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.blockerId == request.auth.uid || isAdmin());
    }

    // 6. Conversations
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 7. Messages
    match /messages/{messageId} {
      // Only sender, receiver or admin can read private message
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      // Only sender can create message, must not be banned, and sender and receiver must be friends (or admin)
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        isNotBanned() &&
        (
          request.resource.data.receiverId == request.auth.uid ||
          areFriends(request.auth.uid, request.resource.data.receiverId) ||
          isAdmin() ||
          exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        );
      // Receiver can mark isRead/reactions, sender can edit text/reactions, admin can update
      allow update: if isAuthenticated() && (
        (resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt', 'reactions'])) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'reactions'])) ||
        isAdmin()
      );
      // Only sender or admin can delete private message
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 9. Presence
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 10. Calls (WebRTC Signaling)
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.callerId == request.auth.uid &&
        isNotBanned() &&
        areNotBlocked(request.auth.uid, request.resource.data.receiverId);
      allow update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );

      // WebRTC Caller Candidates Subcollection
      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      // WebRTC Receiver Candidates Subcollection
      match /receiverCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Call History
    match /callHistory/{historyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.receiverId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // 11. Posts (Community Majlis)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid && isNotBanned();
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 12. Comments
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid && isNotBanned();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 13. Reactions
    match /reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 14. Amal Records
    match /amalRecords/{recordId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 15. Qaza Records
    match /qazaRecords/{recordId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 16. Announcements
    match /announcements/{announcementId} {
      allow read: if true; // Public read
      allow write: if isAdmin();
    }

    // 17. Admin Actions Audit Log
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // 18. Community Counter
    match /communityCounter/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
